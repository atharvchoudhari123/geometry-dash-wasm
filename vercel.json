{
  "functions": {
    "api/proxy.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/__proxy",
      "destination": "/api/proxy"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.wasm",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        }
      ]
    }
  ]
}
